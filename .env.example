# CourseGen Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API Keys (Required for question generation)
# =============================================================================

# Google Gemini API Key (required for question generation)
GOOGLE_API_KEY=your_google_api_key_here

# Multiple Gemini API keys for rotation (optional)
GEMINI_API_KEYS=key1,key2,key3

# Cloudflare Workers AI (required for embeddings)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# =============================================================================
# Application Configuration
# =============================================================================

# Course data and cache paths
COURSEGEN_COURSES_JSON=/app/data/textbooks/courses.json
COURSEGEN_CACHE_DIR=/app/OUTPUT_DATA2/cache

# ChromaDB configuration
CHROMA_PERSIST_DIR=/app/OUTPUT_DATA2/emdeddings
CHROMA_COLLECTION=course_embeddings
CHROMA_LOG_LVL=INFO

# =============================================================================
# Performance Tuning
# =============================================================================

# Threading and processing
OMP_NUM_THREADS=4
CF_EMBED_MAX_BATCH=96
OCR_DPI=450

# API rate limiting
CF_EMBED_QPS=1.0
CF_EMBED_RETRIES=4

# =============================================================================
# Question Generation Settings
# =============================================================================

# Model configuration
COURSEGEN_QUESTION_MODEL=gemini-2.5-flash-lite
COURSEGEN_CALC_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_TOP_K=50
GEMINI_MAX_OUTPUT_TOKENS=10000
USE_THINKING=false
THINKING_BUDGET=12700
COURSEGEN_USE_STRUCTURED=0
COURSEGEN_DEBUG=false

# Question batch sizing
COURSEGEN_THEORY_PER_REQUEST=10
COURSEGEN_CALC_PER_REQUEST=5

# Difficulty configuration (1-10, where 1-3=Easy, 4-6=Medium, 7-10=Hard)
COURSEGEN_THEORY_DIFFICULTY_RANK=2
COURSEGEN_CALCULATION_DIFFICULTY_RANK=2

# Retry and pacing controls
REQUEST_DELAY=1.5
DELAY_JITTER=0.25
REQUEST_ATTEMPTS=2
RAG_ATTEMPTS=2

# Retrieval configuration
RAG_TOPK=30
RAG_FINAL_K=12
RAG_TAU=0.35
RAG_MIN_SIMILARITY=0.6
RAG_CONTEXT_LIMIT=8

# Cache configuration
LATEX_WRAP_STEPS=true
RESUME=true
STORE_FIRESTORE=true
COURSEGEN_DISABLE_CACHE_DAILY_RESET=false

# Email notifications (optional)
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_FROM=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com
GEN_QG_TOP_P=0.85
GEN_QG_MAX_OUT_TOKENS=6000

# RAG configuration
GEN_QG_RAG_TAU=0.35
GEN_QG_RAG_MIN_SIM=0.6
GEN_QG_RAG_TOPK=30
GEN_QG_RAG_MAX=40

# Batch processing
GEN_QG_COURSE_DELAY_S=2.0
GEN_QG_TOPIC_DELAY_S=1.0
GEN_QG_QUERY_DELAY_S=0.5

# =============================================================================
# Billing and Cost Tracking
# =============================================================================

# Enable billing tracking
BILLING_ENABLED=1
CF_PRICE_PER_M_TOKENS=0.02

# =============================================================================
# OCR Configuration (if using OCR features)
# =============================================================================

# OCR language
OCR_LANG=en

# EasyOCR GPU support (0=CPU, 1=GPU)
EASYOCR_GPU=0

# OCR image processing limits
OCR_MAX_IMAGE_BYTES=67108864

# Tesseract configuration (Windows)
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata

# =============================================================================
# Development and Debugging
# =============================================================================

# Logging levels
COURSEGEN_QG_LOGLEVEL=INFO
GEN_QG_LOG_LVL=INFO

# Offline mode (disable remote API calls)
OFFLINE=0

# Cache and resume settings
CHROMA_REQUIRE_EMBEDDINGS=1

# =============================================================================
# Security Settings
# =============================================================================

# Firestore configuration (optional)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Additional security settings
PIP_ROOT_USER_ACTION=ignore
