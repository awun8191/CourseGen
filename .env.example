# Copy this to .env and fill in your values. Never commit .env!
# SECURITY NOTE: Remove sensitive keys before committing .env.example
# For production, use secret management (e.g., Docker secrets, env vars in CI/CD)

# Gemini (required for OCR, question gen, outlines)
GOOGLE_API_KEY=your_google_api_key_here  # Primary key (used if GEMINI_API_KEYS not set)
GEMINI_API_KEYS=key1,key2,key3,key4,key5  # Comma-separated for load balancing (optional, overrides GOOGLE_API_KEY)

# Cloudflare (for embeddings/RAG)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_token_here
CF_EMBED_MAX_BATCH=100  # Batch size for embeddings (default 100)

# Firestore/Firebase (for saving questions/metadata)
FIRESTORE_SERVICE_ACCOUNT=enginneringhub_firebase_service.json  # Path to your service account JSON (mount in Docker)

# Billing/Tracking (optional)
BILLING_ENABLED=1  # 1 to track costs (default 0)
CF_PRICE_PER_M_TOKENS=0.02  # Cloudflare pricing per 1M tokens (USD)

# OCR/Processing (optional, defaults work)
OCR_DPI=120  # DPI for PDF rendering (default 300)
OCR_GEMINI_MAX_EDGE=2000  # Max image edge for Gemini (px, default 2048)
OMP_NUM_THREADS=2  # CPU threads for processing (default 1)

# Paths (relative to /app in container)
PDF_DIRECTORY=data/textbooks  # Input PDFs location
PROCESSED_COURSES_CACHE=data/processed_cache  # Cache for processed courses
CHROMA_PERSIST_DIR=OUTPUT_DATA2/emdeddings  # ChromaDB storage (note: fix 'emdeddings' to 'embeddings' if needed)

# Question Generation (optional)
QUESTION_DIFFICULTY=medium  # Default difficulty (easy/medium/hard)
QUESTION_BATCH_SIZE=10  # Questions per Gemini request (default 10 for theoretical)

# Logging (optional)
LOG_LEVEL=INFO  # Python logging level (DEBUG/INFO/WARNING/ERROR)